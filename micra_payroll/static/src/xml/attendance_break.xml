<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="hr_attendance.CheckInOut" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'flex-grow-1')]" position="replace">
            <div class="flex-grow-1 mt-3">
                <div style="
                    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
                    border: 1px solid #e5e7eb;
                    border-radius: 16px;
                    padding: 14px;
                    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
                ">
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <div style="
                                width: 38px;
                                height: 38px;
                                border-radius: 12px;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                background: linear-gradient(135deg, #eff6ff, #dbeafe);
                                color: #2563eb;
                                font-size: 16px;
                                flex-shrink: 0;
                            ">
                                <i class="fa fa-calendar-check-o"/>
                            </div>
                            <div>
                                <div style="font-size:14px; font-weight:700; color:#111827; line-height:1.2;">
                                    Attendance
                                </div>
                                <div style="font-size:12px; color:#6b7280; line-height:1.2; margin-top:2px;">
                                    Manage your check in and check out
                                </div>
                            </div>
                        </div>

                        <span t-if="props.checkedIn"
                              class="badge rounded-pill"
                              style="background:#ecfdf5; color:#15803d; border:1px solid #86efac; padding:7px 12px; font-size:12px; font-weight:700;">
                            Checked In
                        </span>

                        <span t-if="!props.checkedIn"
                              class="badge rounded-pill"
                              style="background:#fef2f2; color:#b91c1c; border:1px solid #fca5a5; padding:7px 12px; font-size:12px; font-weight:700;">
                            Checked Out
                        </span>
                    </div>

                    <div t-if="props.checkedIn"
                         class="mb-3"
                         style="background:#f0fdf4; border:1px solid #bbf7d0; color:#166534; border-radius:12px; padding:10px 12px; font-size:13px; font-weight:500; display:flex; align-items:center; gap:8px;">
                        <i class="fa fa-sign-in"/>
                        <span>You are currently checked in.</span>
                    </div>

                    <div t-if="!props.checkedIn"
                         class="mb-3"
                         style="background:#fef2f2; border:1px solid #fecaca; color:#991b1b; border-radius:12px; padding:10px 12px; font-size:13px; font-weight:500; display:flex; align-items:center; gap:8px;">
                        <i class="fa fa-sign-out"/>
                        <span>You are currently checked out.</span>
                    </div>

                    <button t-on-click="() => this.onClickSignInOut()"
                            type="button"
                            class="btn w-100 d-flex align-items-center justify-content-center gap-2 fw-bold"
                            t-att-style="
                                'min-height:48px; border:none; border-radius:14px; color:#ffffff; font-size:14px; letter-spacing:0.2px; ' +
                                (props.checkedIn
                                    ? 'background:linear-gradient(135deg, #dc2626 0%, #ef4444 100%); box-shadow:0 10px 20px rgba(239,68,68,0.28);'
                                    : 'background:linear-gradient(135deg, #16a34a 0%, #22c55e 100%); box-shadow:0 10px 20px rgba(34,197,94,0.28);')
                            ">
                        <t t-if="!props.checkedIn">
                            <i class="fa fa-sign-in"/>
                            <span>Check In</span>
                        </t>
                        <t t-else="">
                            <i class="fa fa-sign-out"/>
                            <span>Check Out</span>
                        </t>
                    </button>
                </div>
            </div>
        </xpath>
    </t>

    <t t-inherit="hr_attendance.attendance_menu" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'o_att_menu_container')]" position="inside">

            <div t-if="this.state.checkedIn"
                 class="o_break_panel mt-3 pt-3"
                 style="border-top: 1px solid #e5e7eb;">

                <div class="d-flex flex-column gap-3"
                     style="
                        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
                        border: 1px solid #e5e7eb;
                        border-radius: 16px;
                        padding: 14px;
                        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
                     ">

                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <div style="
                                width: 38px;
                                height: 38px;
                                border-radius: 12px;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                background: linear-gradient(135deg, #ecfeff, #dbeafe);
                                color: #2563eb;
                                font-size: 16px;
                                flex-shrink: 0;
                            ">
                                <i class="fa fa-coffee"/>
                            </div>

                            <div>
                                <div style="font-size:14px; font-weight:700; color:#111827; line-height:1.2;">
                                    Break Management
                                </div>
                                <div style="font-size:12px; color:#6b7280; line-height:1.2; margin-top:2px;">
                                    Working, break and total timers
                                </div>
                            </div>
                        </div>

                        <span t-if="this.breakState.isOnBreak"
                              class="badge rounded-pill"
                              style="background:#fef3c7; color:#b45309; border:1px solid #fcd34d; padding:7px 12px; font-size:12px; font-weight:700;">
                            On Break
                        </span>

                        <span t-if="!this.breakState.isOnBreak"
                              class="badge rounded-pill"
                              style="background:#ecfdf5; color:#15803d; border:1px solid #86efac; padding:7px 12px; font-size:12px; font-weight:700;">
                            Working
                        </span>
                    </div>

                    <div style="
                        display:grid;
                        grid-template-columns:1fr 1fr 1fr;
                        gap:12px;
                    ">
                        <div style="
                            background:#eff6ff;
                            border:1px solid #bfdbfe;
                            border-radius:14px;
                            padding:12px;
                            text-align:center;
                        ">
                            <div style="font-size:12px; color:#475569; font-weight:600; margin-bottom:6px;">
                                Working Time
                            </div>
                            <div style="font-size:22px; font-weight:800; color:#0f172a; letter-spacing:0.5px;">
                                <t t-esc="this.timerState.workingText"/>
                            </div>
                        </div>

                        <div style="
                            background:#fff7ed;
                            border:1px solid #fdba74;
                            border-radius:14px;
                            padding:12px;
                            text-align:center;
                        ">
                            <div style="font-size:12px; color:#7c2d12; font-weight:600; margin-bottom:6px;">
                                Break Time
                            </div>
                            <div style="font-size:22px; font-weight:800; color:#7c2d12; letter-spacing:0.5px;">
                                <t t-esc="this.timerState.breakText"/>
                            </div>
                        </div>

                        <div style="
                            background:#f0fdf4;
                            border:1px solid #86efac;
                            border-radius:14px;
                            padding:12px;
                            text-align:center;
                        ">
                            <div style="font-size:12px; color:#166534; font-weight:600; margin-bottom:6px;">
                                Total Time
                            </div>
                            <div style="font-size:22px; font-weight:800; color:#166534; letter-spacing:0.5px;">
                                <t t-esc="this.timerState.totalText"/>
                            </div>
                        </div>
                    </div>

                    <div t-if="this.breakState.isOnBreak"
                         style="
                            background:#fffbeb;
                            border:1px solid #fde68a;
                            color:#92400e;
                            border-radius:12px;
                            padding:10px 12px;
                            font-size:13px;
                            font-weight:500;
                            display:flex;
                            align-items:center;
                            gap:8px;
                         ">
                        <i class="fa fa-pause-circle"/>
                        <span>Break timer is running. Working timer is paused.</span>
                    </div>

                    <div t-if="!this.breakState.isOnBreak"
                         style="
                            background:#f0fdf4;
                            border:1px solid #bbf7d0;
                            color:#166534;
                            border-radius:12px;
                            padding:10px 12px;
                            font-size:13px;
                            font-weight:500;
                            display:flex;
                            align-items:center;
                            gap:8px;
                         ">
                        <i class="fa fa-briefcase"/>
                        <span>Working timer is running. Break timer is paused.</span>
                    </div>

                    <button type="button"
                            class="btn w-100 d-flex align-items-center justify-content-center gap-2 fw-bold"
                            t-att-disabled="this.breakState.loading"
                            t-on-click="() => this.toggleBreak()"
                            t-att-style="
                                'min-height:48px; border:none; border-radius:14px; color:#ffffff; font-size:14px; letter-spacing:0.2px; ' +
                                (this.breakState.isOnBreak
                                    ? 'background:linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%); box-shadow:0 10px 20px rgba(245,158,11,0.28);'
                                    : 'background:linear-gradient(135deg, #16a34a 0%, #22c55e 100%); box-shadow:0 10px 20px rgba(34,197,94,0.28);')
                            ">
                        <t t-if="this.breakState.loading">
                            <i class="fa fa-spinner fa-spin"/>
                            <span>Please wait...</span>
                        </t>
                        <t t-elif="!this.breakState.isOnBreak">
                            <i class="fa fa-pause-circle"/>
                            <span>Break In</span>
                        </t>
                        <t t-else="">
                            <i class="fa fa-play-circle"/>
                            <span>Break Out</span>
                        </t>
                    </button>

                </div>
            </div>

        </xpath>
    </t>
</templates>