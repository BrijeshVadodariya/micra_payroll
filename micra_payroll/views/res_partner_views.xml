<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_inherit_billing_basis" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.billing.basis</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_payment_term_id']" position="after">
                <field name="billing_basis"/>
            </xpath>
        </field>
    </record>

        <record id="view_partner_form_gstin_vat_switch" model="ir.ui.view">
        <field name="name">res.partner.form.gstin.vat.switch</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Replace original VAT field -->
            <xpath expr="//field[@name='vat']" position="replace">

                <!-- India -->
                <field name="is_india_partner" invisible="1"/>
                <field name="vat"
                       string="GSTIN"
                       placeholder="Enter GSTIN"
                       invisible="not is_india_partner"/>

                <!-- Other countries -->
                <field name="vat"
                       string="VAT"
                       placeholder="Enter VAT Number"
                       invisible="is_india_partner"/>

            </xpath>

        </field>
    </record>

</odoo>