<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_billing_basis" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.billing.basis</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Proper row after pricelist -->
            <xpath expr="//field[@name='payment_term_id']" position="before">
                <field name="billing_basis" string="Qty Type"/>
            </xpath>

            <!-- Order line list -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="replace">
                <field name="product_uom_qty"
                       string="Qty"
                       column_invisible="parent.billing_basis != 'normal'"/>

                <field name="product_uom_qty"
                       string="Qty (Hrs)"
                       column_invisible="parent.billing_basis != 'hour'"/>

                <field name="product_uom_qty"
                       string="Qty (Month)"
                       column_invisible="parent.billing_basis != 'month'"/>
            </xpath>

            <!-- Line form popup -->
            <xpath expr="//field[@name='order_line']/form//field[@name='product_uom_qty']" position="after">
                <field name="billing_basis" readonly="1"/>
            </xpath>

        </field>
    </record>

</odoo>