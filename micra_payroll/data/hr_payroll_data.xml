<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Contribution Register -->
        <record id="contribution_register_employees" model="hr.contribution.register">
            <field name="name">Employees</field>
            <field name="partner_id" eval="False"/>
        </record>

        <!-- Salary Rule Categories -->
        <record id="BASIC" model="hr.salary.rule.category">
            <field name="name">Basic</field>
            <field name="code">BASIC</field>
        </record>
        <record id="ALW" model="hr.salary.rule.category">
            <field name="name">Allowance</field>
            <field name="code">ALW</field>
        </record>
        <record id="GROSS" model="hr.salary.rule.category">
            <field name="name">Gross</field>
            <field name="code">GROSS</field>
        </record>
        <record id="DED" model="hr.salary.rule.category">
            <field name="name">Deduction</field>
            <field name="code">DED</field>
        </record>
        <record id="NET" model="hr.salary.rule.category">
            <field name="name">Net</field>
            <field name="code">NET</field>
        </record>
        <record id="COMP" model="hr.salary.rule.category">
            <field name="name">Company Contribution</field>
            <field name="code">COMP</field>
        </record>
        <record id="HRA" model="hr.salary.rule.category">
            <field name="name">House Rent Allowance</field>
            <field name="code">HRA</field>
            <field name="parent_id" ref="ALW"/>
        </record>
        <record id="DA" model="hr.salary.rule.category">
            <field name="name">Dearness Allowance</field>
            <field name="code">DA</field>
            <field name="parent_id" ref="ALW"/>
        </record>
        <record id="Travel" model="hr.salary.rule.category">
            <field name="name">Travel Allowance</field>
            <field name="code">Travel</field>
            <field name="parent_id" ref="ALW"/>
        </record>
        <record id="Meal" model="hr.salary.rule.category">
            <field name="name">Meal Allowance</field>
            <field name="code">Meal</field>
            <field name="parent_id" ref="ALW"/>
        </record>
        <record id="Medical" model="hr.salary.rule.category">
            <field name="name">Medical Allowance</field>
            <field name="code">Medical</field>
            <field name="parent_id" ref="ALW"/>
        </record>
        <record id="Other" model="hr.salary.rule.category">
            <field name="name">Other Allowance</field>
            <field name="code">Other</field>
            <field name="parent_id" ref="ALW"/>
        </record>

        <!-- Basic Salary Rule (with wage fallback) -->
        <record id="hr_rule_basic" model="hr.salary.rule">
            <field name="name">Basic Salary</field>
            <field name="sequence" eval="1"/>
            <field name="code">BASIC</field>
            <field name="category_id" ref="BASIC"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
result = (contract.wage if contract and contract.wage else 0.0) or (employee.wage if employee and employee.wage else 0.0) or 0.0
            </field>
        </record>

        <!-- Gross Rule -->
        <record id="hr_rule_taxable" model="hr.salary.rule">
            <field name="name">Gross</field>
            <field name="sequence" eval="100"/>
            <field name="code">GROSS</field>
            <field name="category_id" ref="GROSS"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = categories.BASIC + categories.ALW</field>
        </record>

        <!-- Net Salary Rule (Attendance Pro-Rated Calculation + Bonus + Allowances - Deductions) -->
        <record id="hr_rule_net" model="hr.salary.rule">
            <field name="name">Net Salary</field>
            <field name="sequence" eval="200"/>
            <field name="code">NET</field>
            <field name="category_id" ref="NET"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
basic_val = categories.BASIC
working_days = worked_days.WORK_DAYS_MONTH.number_of_days if (worked_days and worked_days.WORK_DAYS_MONTH) else 0.0
payable_days = worked_days.GLOBAL.number_of_days if (worked_days and worked_days.GLOBAL) else 0.0
bonus = (payslip.extra_bonus or 0.0) if payslip and hasattr(payslip, 'extra_bonus') else 0.0
alw = categories.ALW if categories and hasattr(categories, 'ALW') else 0.0

# Deductions other than UNPAID (since payable_days already only pays for worked days and paid leaves)
unpaid_ded = (basic_val / working_days) * payslip.unpaid_leave_days
total_ded = abs(categories.DED) if categories and hasattr(categories, 'DED') else 0.0
other_ded = max(0.0, total_ded - unpaid_ded)

prorated_basic = (basic_val / working_days) * payable_days if working_days > 0 else (basic_val if payable_days > 0 else 0.0)
result = prorated_basic + alw - other_ded + bonus
            </field>
            <field name="register_id" ref="contribution_register_employees"/>
        </record>

        <!-- Standard Allowances & Deductions Rules -->
        <record id="hr_rule_hra" model="hr.salary.rule">
            <field name="name">House Rent Allowance</field>
            <field name="sequence" eval="5"/>
            <field name="code">HRA</field>
            <field name="category_id" ref="HRA"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = (contract.hra or 0.0) if contract else 0.0</field>
        </record>
        <record id="hr_rule_da" model="hr.salary.rule">
            <field name="name">Dearness Allowance</field>
            <field name="sequence" eval="6"/>
            <field name="code">DA</field>
            <field name="category_id" ref="DA"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = (contract.da or 0.0) if contract else 0.0</field>
        </record>
        <record id="hr_rule_travel" model="hr.salary.rule">
            <field name="name">Travel Allowance</field>
            <field name="sequence" eval="7"/>
            <field name="code">Travel</field>
            <field name="category_id" ref="Travel"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = (contract.travel_allowance or 0.0) if contract else 0.0</field>
        </record>
        <record id="hr_rule_meal" model="hr.salary.rule">
            <field name="name">Meal Allowance</field>
            <field name="sequence" eval="8"/>
            <field name="code">Meal</field>
            <field name="category_id" ref="Meal"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = (contract.meal_allowance or 0.0) if contract else 0.0</field>
        </record>
        <record id="hr_rule_medical" model="hr.salary.rule">
            <field name="name">Medical Allowance</field>
            <field name="sequence" eval="9"/>
            <field name="code">Medical</field>
            <field name="category_id" ref="Medical"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = (contract.medical_allowance or 0.0) if contract else 0.0</field>
        </record>
        <record id="hr_rule_other" model="hr.salary.rule">
            <field name="name">Other Allowance</field>
            <field name="sequence" eval="10"/>
            <field name="code">Other</field>
            <field name="category_id" ref="Other"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = (contract.other_allowance or 0.0) if contract else 0.0</field>
        </record>
        <record id="hr_rule_unpaid" model="hr.salary.rule">
            <field name="name">Unpaid</field>
            <field name="sequence" eval="15"/>
            <field name="code">UNPAID</field>
            <field name="category_id" ref="DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
working_days = worked_days.WORK_DAYS_MONTH.number_of_days if (worked_days and worked_days.WORK_DAYS_MONTH) else (payslip.micra_month_working_days or 30.0)
unpaid_days = 0.0
if worked_days and hasattr(worked_days, 'UNPAID') and worked_days.UNPAID:
    unpaid_days = worked_days.UNPAID.number_of_days or 0.0
elif payslip and hasattr(payslip, 'unpaid_leave_days'):
    unpaid_days = payslip.unpaid_leave_days or 0.0
wage = (contract.wage if contract and contract.wage else 0.0) or (employee.wage if employee and employee.wage else 0.0)
daily_rate = (wage / working_days) if working_days > 0 else (wage / 30.0)
result = -(unpaid_days * daily_rate)
            </field>
        </record>

        <!-- Base Salary Structure configured with Attendance-based rules -->
        <record id="structure_base" model="hr.payroll.structure">
            <field name="code">BASE</field>
            <field name="name">Base for new structures</field>
            <field eval="[(6, 0, [ref('hr_rule_basic'), ref('hr_rule_taxable'), ref('hr_rule_net')])]" name="rule_ids"/>
        </record>

        <!-- Decimal Precision -->
        <record forcecreate="True" id="decimal_payroll" model="decimal.precision">
            <field name="name">Payroll</field>
            <field name="digits">2</field>
        </record>
        <record forcecreate="True" id="decimal_payroll_rate" model="decimal.precision">
            <field name="name">Payroll Rate</field>
            <field name="digits">4</field>
        </record>
    </data>
</odoo>
